# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research raw captures (large, not committed)
docs/research/direct/raw/
# test output
/test-results/
/playwright-report/
/.lighthouse/

# raw first-run captures awaiting curation (large PNGs, helper scripts, full-page captures)
docs/research/screenshots/*.png
docs/research/screenshots/*.cjs
docs/research/screenshots/*.js
docs/research/screenshots/*-full.jpg
docs/research/benchmarks/**/*.png
