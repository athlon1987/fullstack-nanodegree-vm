{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3100/en",
        "http://localhost:3100/ms",
        "http://localhost:3100/en/kul/flights",
        "http://localhost:3100/en/journey",
        "http://localhost:3100/en/guides/baggage",
        "http://localhost:3100/en/kul/parking"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance"],
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/(en|ms)$",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 256000 }]
          }
        },
        {
          "matchingUrlPattern": "/(guides|help)/|/(parking|transport|facilities|map|transit|lounges|shop-dine)$",
          "assertions": {
            "resource-summary:total:size": ["error", { "maxNumericValue": 512000 }],
            "resource-summary:total:count": ["error", { "maxNumericValue": 40 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
