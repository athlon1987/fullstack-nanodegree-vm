{
  "name": "pockethood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "POCKETHOOD — a cozy social neighborhood-building game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:import": "node scripts/asset-pipeline/import-netforge.mjs",
    "assets:manifest": "node scripts/asset-pipeline/write-manifest.mjs",
    "assets:validate": "node scripts/validation/validate-assets.mjs",
    "economy:sim": "vite-node scripts/economy/simulate.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "idb-keyval": "6.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "meshoptimizer": "1.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "3.2.4",
    "vitest": "3.2.7"
  }
}
