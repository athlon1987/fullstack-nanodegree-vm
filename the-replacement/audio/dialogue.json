    "WIFE":      { "voice": "af_heart",   "speed": 1.0,  "pitch": 1.0 },
    "MANAGER":   { "voice": "bm_george",  "speed": 1.0,  "pitch": 1.0 },
    "GUARD":     { "voice": "am_puck",    "speed": 1.0,  "pitch": 1.0 },
    "CLERK":     { "voice": "bm_lewis",   "speed": 0.96, "pitch": 1.0 },
    "REP":       { "voice": "bf_emma",    "speed": 0.95, "pitch": 1.0 },
    "SYSTEM":    { "voice": "af_alloy",   "speed": 0.95, "pitch": 1.0 },
